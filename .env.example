# Copy this file to .env and enter your 2.4 GHz Wi-Fi credentials.
# (The Raspberry Pi Pico W only supports 2.4 GHz Wi-Fi networks.)

WIFI_SSID=YOUR_WIFI_SSID
WIFI_PASSWORD=YOUR_WIFI_PASSWORD

# Optional fallback 2.4 GHz networks (e.g. phone hotspot; supports _2 through _5)
# WIFI_SSID_2=YOUR_HOTSPOT_SSID
# WIFI_PASSWORD_2=YOUR_HOTSPOT_PASSWORD

HOSTNAME=rpi-pico
PORT=80

# Optional weather location (defaults to Manila)
WEATHER_CITY=Manila
WEATHER_LAT=14.5995
WEATHER_LON=120.9842
